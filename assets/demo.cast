[0.000, "o", "Work with games and their challenges, teams, and submissions\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1mret2cli game\u001b[0m [OPTIONS] <COMMAND>\r\n\r\n\u001b[1m\u001b[4mCommands:\u001b[0m\r\n  \u001b[1mlist\u001b[0m        List available games\r\n  \u001b[1mshow\u001b[0m        Show one game and its introduction, rules, or cover image\r\n  \u001b[1mselect\u001b[0m      Save the selected game in the current profile\r\n  \u001b[1mscoreboard\u001b[0m  Show the selected game's scoreboard\r\n  \u001b[1mchallenge\u001b[0m   Work with challenges in the selected game\r\n  \u001b[1mteam\u001b[0m        Manage teams in the selected game\r\n  \u001b[1msubmission\u001b[0m  View submission history\r\n  \u001b[1mhelp\u001b[0m        Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--json\u001b[0m               Emit one JSON value on stdout\r\n      \u001b[1m--profile\u001b[0m <PROFILE>  Use a named local connection profile\r\n      \u001b[1m--url\u001b[0m <URL>          Override the API base URL for this invocation\r\n      \u001b[1m--token\u001b[0m <TOKEN>      Override the bearer token for this invocation\r\n      \u001b[1m--pager\u001b[0m <PAGER>      Control paging for human-readable command output [possible values: auto, always, never]\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m               Print help\r\n"]
