[0.001, "o", "CLI client for Ret2Shell CTF platform\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1mret2cli\u001b[0m [OPTIONS] [COMMAND]\r\n\r\n\u001b[1m\u001b[4mCommands:\u001b[0m\r\n  \u001b[1mprofile\u001b[0m      Manage local `Ret2Shell` connection profiles\r\n  \u001b[1maccount\u001b[0m      Account authentication and identity\r\n  \u001b[1mgame\u001b[0m         Work with games and their challenges, teams, and submissions\r\n  \u001b[1minteractive\u001b[0m  Open the interpreter-style interactive shell\r\n  \u001b[1mcompletion\u001b[0m   Generate shell completions\r\n  \u001b[1mhelp\u001b[0m         Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--json\u001b[0m               Emit one JSON value on stdout\r\n      \u001b[1m--profile\u001b[0m <PROFILE>  Use a named local connection profile\r\n      \u001b[1m--url\u001b[0m <URL>          Override the API base URL for this invocation\r\n      \u001b[1m--token\u001b[0m <TOKEN>      Override the bearer token for this invocation\r\n      \u001b[1m--pager\u001b[0m <PAGER>      Control paging for human-readable command output [possible values: auto, always, never]\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m               Print help\r\n  \u001b[1m-V\u001b[0m, \u001b[1m--version\u001b[0m            Print version\r\n\r\n\r\nInteractive built-ins:\r\n  help [COMMAND...]  Show command help\r\n  context             Show the active profile, account, and game\r\n  exit, quit          Leave the interactive shell\r\n"]
